/*
 * Psych Ward OS — Фаза 13. Шаблон FIT-образа для U-Boot bootm.
 * Обёртывает sel4test-driver-image-arm-bcm2711 (elfloader+kernel+rootserver,
 * собран и подписан как в Фазе 12 — сама сборка НЕ меняется) в подписываемый
 * контейнер. load/entry = 0x10000000 — тот же адрес, что раньше был жёстко
 * прописан в boot.scr (fatload ...; go 0x10000000), просто переиспользуется.
 *
 * @@IMAGE_PATH@@ подставляется build_and_sign.sh на абсолютный путь до
 * актуального load_chain/sel4test-driver-image-arm-bcm2711 перед вызовом
 * mkimage -f — руками этот файл не собирается.
 */

/dts-v1/;

/ {
	description = "Psych Ward OS -- signed seL4 boot image (Фаза 13)";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "seL4 rootserver + elfloader";
			data = /incbin/("@@IMAGE_PATH@@");
			type = "kernel";
			arch = "arm64";
			os = "u-boot";
			compression = "none";
			load = <0x10000000>;
			entry = <0x10000000>;
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Psych Ward OS default boot configuration";
			kernel = "kernel-1";
			signature-1 {
				algo = "sha256,rsa2048";
				key-name-hint = "dev";
				sign-images = "kernel";
			};
		};
	};
};

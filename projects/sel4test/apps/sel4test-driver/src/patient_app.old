#include <sel4/sel4.h>

__attribute__((weak)) LIBSEL4_THREAD_LOCAL seL4_IPCBuffer *__sel4_ipc_buffer = nullptr;

void __assert_fail(const char *assertion, const char *file, int line, const char *function) { while(1); }

// ============================================================================
// 1. СИСКОЛЛЫ ОБОЛОЧКИ (ОБНОВЛЕНЫ ДЛЯ ПРЯМОГО IPC С ДРАЙВЕРОМ)
// ============================================================================
static void sys_puts(seL4_CPtr console_ep, const char* str) {
    int i = 0;
    seL4_SetMR(0, 8); // SYS_PUTS
    while (*str && i < 110) {
        seL4_SetMR(i + 1, (seL4_Word)*str++);
        i++;
    }
    seL4_Call(console_ep, seL4_MessageInfo_new(0, 0, 0, i + 1));
    if (*str) sys_puts(console_ep, str);
}

static char sys_read(seL4_CPtr console_ep) {
    seL4_SetMR(0, 6); // SYS_READ
    seL4_Call(console_ep, seL4_MessageInfo_new(0, 0, 0, 1));
    return (char)seL4_GetMR(0);
}

// Сисколлы к Rootserver остаются без изменений (им нужен root_ep)
static void sys_print(seL4_CPtr root_ep, seL4_Word val) { seL4_SetMR(0, 1); seL4_SetMR(1, val); seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 2)); }
static void sys_sleep(seL4_CPtr root_ep, seL4_Word ms) { seL4_SetMR(0, 4); seL4_SetMR(1, ms); seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 2)); }
static int my_strcmp(const char *s1, const char *s2) { while (*s1 && (*s1 == *s2)) { s1++; s2++; } return *(const unsigned char*)s1 - *(const unsigned char*)s2; }


// --- Вспомогательные функции (без дубликатов) ---

static seL4_Word my_strlen(const char *s) {
    seL4_Word len = 0;
    while (*s++) len++;
    return len;
}

static void my_strcpy(char *dest, const char *src) {
    while ((*dest++ = *src++));
}
// -----------------------------------------------

// ============================================================================
// 2. РЕЖИМ ДРАЙВЕРА (ИЗОЛИРОВАННЫЙ ПРОЦЕСС)
// ============================================================================
void run_uart_driver(seL4_CPtr console_ep, seL4_CPtr irq_handler) {
    // Драйвер напрямую работает с физической памятью железа!
    volatile seL4_Uint32 *uart_dr = (volatile seL4_Uint32*)(0x200000000ULL);
    volatile seL4_Uint32 *uart_fr = (volatile seL4_Uint32*)(0x200000000ULL + 0x18);

    char kbd_buffer[128];
    int head = 0, tail = 0;

    while(1) {
        seL4_Word badge = 0;
        // Драйвер ждет либо аппаратного прерывания, либо сообщения от Shell'а
        seL4_MessageInfo_t info = seL4_Recv(console_ep, &badge);

        if (badge == 1) { // Это прерывание UART_IRQ_BADGE от железа!
            while (((*uart_fr) & (1 << 4)) == 0) { // Пока буфер не пуст
                kbd_buffer[head] = *uart_dr;
                head = (head + 1) % 128;
            }
            seL4_IRQHandler_Ack(irq_handler); // Говорим железу: "Я обработал"
            continue; 
        }

        // Это прямое P2P сообщение от Shell (Syscall)
        seL4_Word sys = seL4_GetMR(0);
        if (sys == 8) { // SYS_PUTS
            int len = seL4_MessageInfo_get_length(info);
            for(int i = 1; i < len; i++) {
                char c = (char)seL4_GetMR(i);
                while ((*uart_fr) & (1 << 5)); // Ждем готовности железа
                *uart_dr = c;
            }
            seL4_Reply(seL4_MessageInfo_new(0, 0, 0, 0));
        } 
        else if (sys == 6) { // SYS_READ
            if (head != tail) {
                seL4_SetMR(0, kbd_buffer[tail]);
                tail = (tail + 1) % 128;
            } else {
                seL4_SetMR(0, (seL4_Word)-1); // EAGAIN
            }
            seL4_Reply(seL4_MessageInfo_new(0, 0, 0, 1));
        }
    }
}

// ============================================================================
// 3. РЕЖИМ ОБОЛОЧКИ (ОБЫЧНЫЙ ПРОЦЕСС)
// ============================================================================
void run_shell(seL4_CPtr root_ep, seL4_CPtr console_ep) {
    sys_puts(console_ep, "\n======================================================\n");
    sys_puts(console_ep, "  USER-SPACE DRIVER & PEER-TO-PEER IPC ACTIVE!        \n");
    sys_puts(console_ep, "======================================================\n\n");
    
    while (1) {
        sys_puts(console_ep, "sandbox> ");
        char cmd[64]; int i = 0;
        
        while (i < 63) {
            char c = sys_read(console_ep); // Читаем напрямую у Драйвера!
            
            if (c == (char)-1 || c == (char)255) { seL4_Yield(); continue; } // Кооперативная многозадачность
            
            if (c == '\r' || c == '\n') { sys_puts(console_ep, "\n"); break; }
            else if (c == 127 || c == '\b') { 
                if (i > 0) { i--; sys_puts(console_ep, "\b \b"); }
            } else { 
                char tmp[2] = {c, 0}; sys_puts(console_ep, tmp); cmd[i++] = c; 
            }
        }
        cmd[i] = '\0';
        
        if (i > 0) {
            // Разделяем команду и аргумент (например, "kill 2" -> cmd="kill", arg="2")
            char *arg = cmd;
            while (*arg && *arg != ' ') arg++;
            if (*arg == ' ') { *arg = '\0'; arg++; while (*arg == ' ') arg++; } else { arg = nullptr; }

            if (my_strcmp(cmd, "ls") == 0) {
                char *shm = (char*)0x502000;     // Адрес Shared Memory в пространстве Пациента
                __sel4_ipc_buffer->msg[0] = 101; // SYS_LS
                seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 1));
                sys_puts(console_ep, shm);
            } 
            else if (my_strcmp(cmd, "ps") == 0) {
                char *shm = (char*)0x502000;
                __sel4_ipc_buffer->msg[0] = 104; // SYS_PS
                seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 1));
                sys_puts(console_ep, shm);
            }
            //--------------------------------------------------------
            else if (my_strcmp(cmd, "echo") == 0) {
                if (!arg) { sys_puts(console_ep, "Usage: echo <text> <filename>\n"); continue; }
                
                // Простейший парсинг: echo "hello" test.txt
                char *text = arg;
                char *fname = arg;
                while (*fname && *fname != ' ') fname++;
                if (*fname == ' ') { *fname = '\0'; fname++; }

                char *shm = (char*)0x502000;
                my_strcpy(shm, fname);
                char *shm_content = shm + my_strlen(fname) + 1;
                my_strcpy(shm_content, text);

                __sel4_ipc_buffer->msg[0] = 105; // SYS_WRITEFILE
                __sel4_ipc_buffer->msg[1] = my_strlen(text);
                seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 2));
                sys_puts(console_ep, "File saved to RAM disk.\n");
            }
            else if (my_strcmp(cmd, "cat") == 0) {
                if (!arg) { sys_puts(console_ep, "Usage: cat <filename>\n"); continue; }
                char *shm = (char*)0x502000;
                my_strcpy(shm, arg);
                __sel4_ipc_buffer->msg[0] = 98; // SYS_READFILE
                seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 1));
                sys_puts(console_ep, "---\n");
                sys_puts(console_ep, shm);
                sys_puts(console_ep, "\n---\n");
            }
            //--------------------------------------------------------
            else if (my_strcmp(cmd, "kill") == 0) {
                if (!arg) { 
                    sys_puts(console_ep, "Usage: kill <pid>\n"); 
                } else {
                    // Простой перевод строки в число (atoi)
                    int target = 0;
                    for(int j=0; arg[j]>='0' && arg[j]<='9'; j++) { target = target*10 + (arg[j]-'0'); }
                    
                    __sel4_ipc_buffer->msg[0] = 102; // SYS_KILL
                    __sel4_ipc_buffer->msg[1] = target;
                    seL4_Call(root_ep, seL4_MessageInfo_new(0, 0, 0, 2));
                    sys_puts(console_ep, "Assassination attempt completed.\n");
                }
            } 
            else if (my_strcmp(cmd, "help") == 0) {
                sys_puts(console_ep, "Available: ls, ps, kill, help\nDriver isolation successful!\n");
            }
             
            else {
                sys_puts(console_ep, "Unknown command\n");
            }
        }
    }
}

// ============================================================================
// ТОЧКА ВХОДА (РАЗДВОЕНИЕ ЛИЧНОСТИ)
// ============================================================================
extern "C" void __sel4_start_c(void) {
    seL4_Word fake_tls_base = 0x501800; 
    asm volatile("msr tpidr_el0, %0" :: "r"(fake_tls_base));

    seL4_IPCBuffer *ipc = (seL4_IPCBuffer*)0x501000;
    __sel4_ipc_buffer = ipc;

    int is_driver = ipc->msg[0]; // Читаем флаг, который нам выдал Rootserver
    
    if (is_driver) {
        seL4_CPtr console_ep = ipc->caps_or_badges[0];
        seL4_CPtr irq_handler = ipc->caps_or_badges[1];
        run_uart_driver(console_ep, irq_handler);
    } else {
        seL4_CPtr root_ep = ipc->userData;
        seL4_CPtr console_ep = ipc->caps_or_badges[0];
        run_shell(root_ep, console_ep);
    }
}
























